{
  "name": "@blazephoenix/mcp",
  "version": "1.0.0",
  "description": "BlazePhoenix MCP server for AI agents \u2014 on-chain DEX aggregator tools (quote, build, verify, simulate swaps) that run on YOUR machine against YOUR RPC. Zero custody: it returns unsigned transactions, never holds a key.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "blazephoenix",
    "dex-aggregator",
    "defi",
    "swap",
    "ai-agent",
    "byo-rpc",
    "base",
    "ethereum",
    "arbitrum",
    "optimism"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blazephoenixxyz-crypto/blazephoenix-mcp.git"
  },
  "homepage": "https://github.com/blazephoenixxyz-crypto/blazephoenix-mcp#readme",
  "type": "module",
  "bin": {
    "blazephoenix-mcp": "dist/index.js"
  },
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "tsx scripts/test.ts",
    "start": "node dist/index.js",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm run build && npm test"
  },
  "dependencies": {
    "@blazephoenix/sdk": "^1.0.0",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "viem": "^2.21.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
